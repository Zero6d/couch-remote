{
  "name": "couch-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Launch, close and put to sleep your gaming PC from your phone over home Wi-Fi.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-icons.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "pair": "node dist/pair.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
